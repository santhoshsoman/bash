trimspaces() {
  if [[ "$OSTYPE" == "darwin"* ]]; then
    _run_cmd sed -i '' 's/[[:blank:]]*$//' "$1"
  else
    _run_cmd sed -i 's/[[:blank:]]*$//' "$1"
  fi
  echo "Trimmed trailing spaces in: $1"
}

