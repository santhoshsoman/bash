ot_sunfish() {
  local log_file="$HOME/tmp/ot_sunfish.log"
  mkdir -p "$(dirname "$log_file")"

  # Trap Ctrl+C (SIGINT) to log the interruption and print a clean ending banner
  trap '
    echo "==================================================" | tee -a "$log_file"
    echo " Interrupted by user at $(date)" | tee -a "$log_file"
    echo "==================================================" | tee -a "$log_file"
    trap - INT
    return 130
  ' INT

  echo "==================================================" | tee "$log_file"
  echo " Starting ot_sunfish at $(date)" | tee -a "$log_file"
  echo " Log file: $log_file"
  echo "==================================================" | tee -a "$log_file"

  _log_cmd "python3 ot_sunfish.py --skip_test_mode_prompt --skip_external_sfc --skip_employee_prompt --execution_mode=continue_on_fail"
  # Run the python script, piping both stdout and stderr to tee, and filtering console output
  python3 ot_sunfish.py --skip_test_mode_prompt --skip_external_sfc --skip_employee_prompt --execution_mode=continue_on_fail 2>&1 | tee -a "$log_file" | grep --line-buffered -E "ENGINE Bus STARTING|ENGINE Starting WebSocket processing|ENGINE Serving on http://0\.0\.0\.0:|ENGINE Bus STARTED"
  
  # Capture the exit status of the python script in a cross-shell compatible way
  local exit_status
  if [[ -n "$ZSH_VERSION" ]]; then
    exit_status=${pipestatus[1]}
  else
    exit_status=${PIPESTATUS[0]}
  fi

  # Reset the trap back to default since we finished normally
  trap - INT

  echo "==================================================" | tee -a "$log_file"
  if [ $exit_status -eq 0 ]; then
    echo " Finished successfully at $(date)" | tee -a "$log_file"
  else
    echo " Failed with exit status $exit_status at $(date)" | tee -a "$log_file"
  fi
  echo "==================================================" | tee -a "$log_file"

  return $exit_status
}

ot_log() {
  local port="8899"
  if [[ "$USER" == "testusr" ]]; then
    port="8090"
  fi
  _run_cmd vim ~/opentest_logs${port}/opentest_plan"${1}".MainProcessPlan.log
}

# Advanced Git Functions
gitclone() {
  local repo=${1:-''}
  [ -z "$repo" ] && { my_echo "Pass repo name as argument" "$MY_RED"; return 1; }

  verbose_run "git clone https://mfg-partners.googlesource.com/${repo} && cd ${repo}"

  # Setup commit-msg hook
  local hook_path
  hook_path="$(git rev-parse --git-dir)/hooks/commit-msg"
  mkdir -p "$(dirname "$hook_path")"
  _run_cmd curl -Lo "$hook_path" https://gerrit-review.googlesource.com/tools/hooks/commit-msg
  _run_cmd chmod +x "$hook_path"
}

run_in_all_repos() {
  # Helper to run commands in all sub-git directories
  local cmd="$1"
  find . -name .git -type d | cut -d / -f 2 | while read -r dir; do
  cd "$dir" || continue
  verbose_run "$cmd"
  cd - >/dev/null || return
done
}

# ==============================================================================
# 4. SSH & LAB MANAGEMENT
# ==============================================================================
_gcert() {
  local hostname="$1"
  local username="santhoshsnair"
  echo "--- Checking gcert on Mac ---"
  verbose_run "gcertstatus --check_remaining=8h || gcert"

  echo "--- Checking gcert on ${hostname} ---"
  _run_cmd ssh "${username}@${hostname}" "gcertstatus --check_remaining=8h || gcert"
}

cth_gcert() {
  _gcert "cth.c.googlers.com"
}
santhoshsnair_gcert() {
  _gcert "santhoshsnair.c.googlers.com"
}

# Connect to a cloudtop over SSH + tmux (via tmx2).
#
# WHY NOT --gmosh: gmosh does not support gnubbies (go/mosh#recommendations).
# A mosh *reattach* resumes the terminal without establishing a new SSH
# session, so the forwarded ssh-agent socket under ~/.ssh/agent/ is never
# recreated. tmx2 only re-points the stable symlink
# ~/.tmp/.$USER.ssh_auth_sock when it is invoked from OUTSIDE tmux
# (/usr/bin/tmx2 line 49), which never happens on a reattach. Result: the
# symlink dangles and `ssh-add -l` fails with
# "Error connecting to agent: No such file or directory" on day 2.
#
# --tmux expands to `tmx2 new-session -A -s <session> || tmux ...`, i.e. it
# still uses tmx2 -- it just runs it over a real SSH session, so the agent
# socket is refreshed on every reconnect. Session persistence comes from
# tmux, not from mosh, so nothing is lost by dropping gmosh.
_connect_google_host() {
  local hostname="$1"
  local tmux_session="${2:-sunfish}"
  local username="santhoshsnair"

  echo "--- Checking gcert on Mac ---"
  verbose_run "gcertstatus --check_remaining=8h || gcert"

  if [ $? -eq 0 ]; then
    verbose_run "LC_ALL=en_US.UTF-8 rw --remote_gcert_args \"--lifetime=168h --nocorpssh --noprodssh\" --ensure_cloudtop_on --tmux --tmux_session ${tmux_session} ${hostname}"
  else
    echo "Local gcert failed, aborting SSH."
    return 1
  fi
}

# Opt-in mosh variant. Survives laptop sleep / IP changes better, but WILL
# break gnubby-backed ssh-agent forwarding after a reattach -- run
# `fix_ssh_agent` on the cloudtop, or reconnect with the plain helper above.
_connect_google_host_mosh() {
  local hostname="$1"
  local tmux_session="${2:-sunfish}"

  echo "--- Checking gcert on Mac ---"
  verbose_run "gcertstatus --check_remaining=8h || gcert"

  if [ $? -eq 0 ]; then
    verbose_run "LC_ALL=en_US.UTF-8 rw --remote_gcert_args \"--lifetime=168h --nocorpssh --noprodssh\" --ensure_cloudtop_on --gmosh --tmux_session ${tmux_session} ${hostname}"
  else
    echo "Local gcert failed, aborting SSH."
    return 1
  fi
}

# Refresh credentials on a running cloudtop WITHOUT opening a shell. This
# re-establishes an SSH session, which re-runs tmx2 from outside tmux and
# re-points the stable SSH_AUTH_SOCK symlink. Already-running tmux panes pick
# it up automatically because the symlink path never changes.
_refresh_google_host() {
  local hostname="$1"
  verbose_run "LC_ALL=en_US.UTF-8 rw -r --nossh_interactively ${hostname}"
}

santhoshsnair() {
  _connect_google_host "santhoshsnair.c.googlers.com" "${1:-santhoshsnair}"
}

cth() {
  _connect_google_host "cth.c.googlers.com" "${1:-sunfish}"
}

cth_mosh() {
  _connect_google_host_mosh "cth.c.googlers.com" "${1:-sunfish}"
}

cth_refresh() {
  _refresh_google_host "cth.c.googlers.com"
}

santhoshsnair_refresh() {
  _refresh_google_host "santhoshsnair.c.googlers.com"
}


alias lab='_run_cmd "${HOME}/santhoshsnair/scripts/lab_login.sh" lab'
alias ilab='_run_cmd "${HOME}/santhoshsnair/scripts/lab_login.sh" ilab'
alias lab-tunnels='_run_cmd "${HOME}/santhoshsnair/scripts/lab_tunnels.sh"'
alias lab-tunnels-santhoshsnair='_run_cmd "${HOME}/santhoshsnair/scripts/lab_tunnels_santhoshsnair.sh"'

lsssh() {
  verbose_run "lsof -i -n | grep gnubby-ssh"
}

fix_ssh_agent() {
  local target_sock=""

  # 1. Prefer active forwarded SSH agent socket (provides corp/prod certs)
  if command -v ss >/dev/null 2>&1; then
    target_sock=$(ss -xl src "$HOME/.ssh/agent/*" 2>/dev/null | awk 'index($5, ".sshd.") {print $5}' | tail -n 1)
  fi

  # 2. Fall back to active local ssh-agent socket
  if [ -z "$target_sock" ] && command -v ss >/dev/null 2>&1; then
    target_sock=$(ss -xl src "$HOME/.ssh/agent/*" 2>/dev/null | awk 'index($5, ".local.") {print $5}' | tail -n 1)
  fi

  # 3. Fall back to scanning ~/.ssh/agent for any responding socket
  if [ -z "$target_sock" ]; then
    local sock
    for sock in $(ls -t "$HOME/.ssh/agent"/s.* 2>/dev/null); do
      if SSH_AUTH_SOCK="$sock" ssh-add -l >/dev/null 2>&1 || [ $? -eq 1 ]; then
        target_sock="$sock"
        break
      fi
    done
  fi

  # 4. If no agent is running, start a new one
  if [ -z "$target_sock" ]; then
    eval $(ssh-agent -s) >/dev/null
    target_sock="$SSH_AUTH_SOCK"
    echo "Started new ssh-agent (PID: $SSH_AGENT_PID)"
  fi

  # Update the stable symlink
  mkdir -p "$HOME/.tmp"
  ln -sf "$target_sock" "$HOME/.tmp/.santhoshsnair.ssh_auth_sock"
  export SSH_AUTH_SOCK="$HOME/.tmp/.santhoshsnair.ssh_auth_sock"

  # Load standard local keys if present
  local key
  for key in "$HOME/.ssh/id_rsa" "$HOME/.ssh/id_rsa_lab" "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_rsa_ilab" "$HOME/devlabs_id_rsa"; do
    [ -f "$key" ] && ssh-add "$key" 2>/dev/null
  done

  # Sync socket to tmux environment if tmux is present
  if command -v tmux >/dev/null 2>&1; then
    tmux set-environment -g SSH_AUTH_SOCK "$HOME/.tmp/.santhoshsnair.ssh_auth_sock" 2>/dev/null
    tmux set-environment SSH_AUTH_SOCK "$HOME/.tmp/.santhoshsnair.ssh_auth_sock" 2>/dev/null
  fi

  echo "SSH_AUTH_SOCK -> $target_sock"
  _run_cmd ssh-add -l
}
alias fix-ssh-agent='fix_ssh_agent'


kill_ssh_port() {
  local port=$1
  [ -z "$port" ] && { echo "Error: Please provide a port number."; return 1; }

  local pids
  pids=$(lsof -ti :"$port")
  if [ -z "$pids" ]; then
    echo "No processes found using port $port."
  else
    echo "Killing processes using port $port: $pids"
    _run_cmd kill $pids
  fi
}

tmx() {
  local tmux_session=${1:-"santhoshsnair"}
  _run_cmd tmx2 new -A -s "$tmux_session"
}

nomachine_base() {
  local user=$1
  local lab_machine=$2
  local port=$3

  [[ -z $port || -z $lab_machine ]] && { my_echo "Pass lab_machine and port" "$MY_RED"; return 1; }

  verbose_run "gcertstatus -nocheck_ssh -check_remaining=1h || gcert"
  verbose_run "ssh -f -N -L ${port}:localhost:4000 ${user}@${lab_machine}"
  verbose_run "pkill nxplayer"

  # Determine session file path based on user
  local session_file="/Users/santhoshsnair/Documents/NoMachine/${lab_machine}.nxs"
  [ "$user" == "santhoshsnair" ] && session_file="/Users/santhoshsnair/Documents/NoMachine/${lab_machine}-santhoshsnair.nxs"

  verbose_run "/Applications/NoMachine.app/Contents/MacOS/nxplayer --session ${session_file}"
}

nomachine() {
  nomachine_base "testusr" "$1" "$2"
}
mu_nomachine() {
  nomachine_base "santhoshsnair" "$1" "$2"
}

# ==============================================================================
# 5. STATION DIAGNOSTICS
# ==============================================================================

chiller_dashboard() {
  local user="testusr"
  local lab_machine="$1"
  local port=5000

  if [ $# -eq 2 ]; then
    user="$1"
    lab_machine="$2"
  elif [[ "$1" == *@* ]]; then
    user="${1%%@*}"
    lab_machine="${1#*@}"
  fi

  [[ -z $lab_machine ]] && {
    my_echo "Usage: chiller_dashboard [user] <lab_machine>" "$MY_RED"
    my_echo "Example: chiller_dashboard sfcth9" "$MY_YELLOW"
    my_echo "         chiller_dashboard testusr@sfcth9" "$MY_YELLOW"
    return 1
  }

  # Specifically look for an existing SSH tunnel forwarding this chiller port (port 5000)
  local existing_ssh_pids=""
  if command -v pgrep >/dev/null 2>&1; then
    existing_ssh_pids=$(pgrep -f "ssh.*${port}:localhost:${port}" 2>/dev/null)
  fi
  if [[ -z "$existing_ssh_pids" ]] && command -v lsof >/dev/null 2>&1; then
    existing_ssh_pids=$(lsof -a -c ssh -ti "tcp:${port}" 2>/dev/null)
  fi

  if [[ -n "$existing_ssh_pids" ]]; then
    my_echo "WARNING: An existing chiller SSH tunnel on port ${port} is running:" "$MY_YELLOW"
    if command -v ps >/dev/null 2>&1; then
      ps -fp $existing_ssh_pids 2>/dev/null
    fi

    if ! my_proceed "Kill existing chiller SSH tunnel and start new one?"; then
      my_echo "Aborted." "$MY_RED"
      return 1
    fi

    my_echo "Stopping chiller SSH tunnel (PID: $existing_ssh_pids)..." "$MY_YELLOW"
    kill $existing_ssh_pids 2>/dev/null
    sleep 1

    local remaining_ssh_pids=""
    if command -v pgrep >/dev/null 2>&1; then
      remaining_ssh_pids=$(pgrep -f "ssh.*${port}:localhost:${port}" 2>/dev/null)
    elif command -v lsof >/dev/null 2>&1; then
      remaining_ssh_pids=$(lsof -a -c ssh -ti "tcp:${port}" 2>/dev/null)
    fi

    if [[ -n "$remaining_ssh_pids" ]]; then
      kill -9 $remaining_ssh_pids 2>/dev/null
      sleep 1
    fi
    my_echo "Chiller SSH tunnel stopped." "$MY_GREEN"
  fi

  # Check if port is in use by a non-SSH process
  local other_pids=""
  if command -v lsof >/dev/null 2>&1; then
    other_pids=$(lsof -ti "tcp:${port}" 2>/dev/null)
  fi
  if [[ -n "$other_pids" ]]; then
    my_echo "ERROR: Port ${port} is currently in use by a non-SSH process:" "$MY_RED"
    lsof -i "tcp:${port}" 2>/dev/null
    if [[ "$(uname)" == "Darwin" ]] && lsof -i "tcp:${port}" 2>/dev/null | grep -q "ControlCenter"; then
      my_echo "Note: Port ${port} is held by macOS AirPlay Receiver (ControlCenter)." "$MY_RED"
      my_echo "Disable it via System Settings -> General -> AirDrop & AirPlay." "$MY_YELLOW"
    fi
    return 1
  fi

  verbose_run "ssh -f -N -L ${port}:localhost:${port} ${user}@${lab_machine}"
}

# ==============================================================================
# 6. DEVELOPMENT TOOLS (Python/Cscope)
# ==============================================================================
cspy() {
  _cscope_gen "py,cfg,ini,csv"
}

csc() {
  _cscope_gen "c,cpp,h,hpp"
}

_cscope_gen() {
  local extensions="$1"
  rm -f cscope* ncscope*

  # Generate find arguments based on extensions
  local find_args=""
  for ext in $(echo $extensions | tr "," "\n"); do
    find_args="$find_args -name '*.$ext' -o"
  done
  find_args=${find_args%-o} # Remove trailing -o

  local tmp_list=$(mktemp "/tmp/${USER}_cscope_XXXXXX.txt")

  # Use eval to handle the dynamic find arguments
  eval "find -L . -type f \( $find_args \) -print" | grep -v 'obj-' >> "$tmp_list"

  sort "$tmp_list" -u > cscope.files
  rm "$tmp_list"

  _run_cmd cscope -v -buqk -F cscope.files -f cscope.out
  _run_cmd cscope -d -p9
}

tox_command() {
  _run_cmd /home/testusr/viper-test/.tox/py3/bin/python -m pytest unit_tests
  _run_cmd python3 -m pylint --output-format=colorized config -d duplicate-code
