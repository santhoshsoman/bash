#!/bin/bash

# ==============================================================================
# 1. COLORS & CORE UTILITIES
# ==============================================================================
export MY_DEFAULT='\033[0m'
export MY_BLACK='\033[0;30m'
export MY_RED='\033[0;31m'
export MY_GREEN='\033[0;32m'
export MY_YELLOW='\033[0;33m'
export MY_BLUE='\033[0;34m'
export MY_MAGENTA='\033[0;35m'
export MY_CYAN='\033[0;36m'
export MY_GRAY='\033[0;37m'
export MY_LIGHT_GREEN='\033[0;92m'

my_echo() {
  echo -e "${2}${1}${MY_DEFAULT}"
}

_log_cmd() {
  echo -e "${MY_YELLOW}[CMD] $*${MY_DEFAULT}" >&2
}

_run_cmd() {
  _log_cmd "$*"
  "$@"
}

verbose_run() {
  local cmd="$*"
  _log_cmd "$cmd"
  eval "$cmd"
}

my_proceed() {
  local in_message=${1:-"Do you want to proceed?"}
  while true; do
    read -r -p "$in_message [y/n] :- " yn
    case $yn in
      [Yy]* ) return 0;;
      [Nn]* ) return 1;;
      * ) my_echo "Please answer yes or no " "$MY_RED";;
    esac
  done
}

my_help_sample_usage() {
  my_echo "SAMPLE USAGE" "$MY_LIGHT_GREEN"
  my_echo "  $1 $2" "$MY_LIGHT_GREEN"
}

# ==============================================================================
# 2. NAVIGATION & FILESYSTEM
# ==============================================================================
alias sss='_log_cmd "unalias -a; unset _SSN_COMMON_SH_LOADED _SSN_SF_COMMON_SH_LOADED; source ~/.bashrc"; unalias -a; unset _SSN_COMMON_SH_LOADED _SSN_SF_COMMON_SH_LOADED; [ -f "$HOME/santhoshsnair/.bashrc" ] && source "$HOME/santhoshsnair/.bashrc" || source "$HOME/.bashrc"'
