alias rlab='_run_cmd "${HOME}/santhoshsnair/scripts/lab_rsync.sh" --mode lab'
alias rilab='_run_cmd "${HOME}/santhoshsnair/scripts/lab_rsync.sh" --mode ilab'
alias rcloud='_run_cmd "${HOME}/santhoshsnair/scripts/lab_rsync.sh" --mode cloud'
alias rall='rlab && rilab && rcloud'

rsyncfrom() {
  local user=${1:-santhoshsnair}
  local remote_machine=${2}
  local remote_dir=${3:-${PWD}}
  local local_dir=${4:-${PWD}}

  [ -z "$remote_machine" ] && { my_help_sample_usage "${FUNCNAME}" "user remote_machine remote_dir local_dir"; return 1; }

  local pass_file="${HOME}/santhoshsnair/passwords/password_${user}.txt"
  _run_cmd sshpass -f "${pass_file}" rsync -avz -e ssh "${user}@${remote_machine}:${remote_dir}" "${local_dir}"
}

rsyncto() {
  local remote_machine=${1}
  local local_dir=${2:-${HOME}/santhoshsnair}
  local user=${3:-santhoshsnair}
  local remote_dir=${4:-""}

  [ -z "$remote_machine" ] && { my_help_sample_usage "${FUNCNAME}" "remote_machine local_dir user remote_dir"; return 1; }

  local pass_file="${HOME}/santhoshsnair/passwords/password_${user}.txt"
  _run_cmd sshpass -f "${pass_file}" rsync -avz -e ssh "${local_dir}" "${user}@${remote_machine}:${remote_dir}"
}

# Check status of specific lab services
check_lab_services() {
  SERVICES=(
  "isc-dhcp-server"
  "tftpd-hpa"
  "NetworkManager"
  "radvd"
  "httpfileserverd"
  "isc-dhcp-server6"
  "chillermonitor"
  "rectifier_controller"
)

  _log_cmd "systemctl is-active --quiet ${SERVICES[*]}"
  my_echo "--- SERVICE STATUS REPORT ---" "$MY_CYAN"

  for service in "${SERVICES[@]}"; do
    if systemctl is-active --quiet "$service"; then
      printf "%-30s [ %bACTIVE%b ]\n" "$service" "$MY_GREEN" "$MY_DEFAULT"
    else
      if systemctl is-failed --quiet "$service"; then
        printf "%-30s [ %bFAILED%b ]\n" "$service" "$MY_RED" "$MY_DEFAULT"
      else
        printf "%-30s [ %bINACTIVE%b ]\n" "$service" "$MY_YELLOW" "$MY_DEFAULT"
      fi
    fi
  done
  echo ""
}

alias chks="check_lab_services"

# Check status of process plan stations
check_stations() {
  local port=${1:-8090}
  _log_cmd "curl -s --max-time 0.5 http://127.0.0.1:${port}/get_process_station_ui?station_id={1..16}"
  echo "Checking stations on port $port..."
  for i in {1..16}; do
    res=$(curl -s --max-time 0.5 "http://127.0.0.1:${port}/get_process_station_ui?station_id=$i")
    if [ -z "$res" ]; then
      echo -e "Station $i: ${MY_RED}UNREACHABLE${MY_DEFAULT}"
    else
      status=$(python3 -c "import sys, json; print(json.loads(sys.stdin.read()).get('current_status', ''))" <<< "$res" 2>/dev/null)
      case "$status" in
        1) label="${MY_GREEN}IDLE${MY_DEFAULT}" ;;
        3) label="${MY_CYAN}RUNNING${MY_DEFAULT}" ;;
        4) label="${MY_YELLOW}WAITING${MY_DEFAULT}" ;;
        *) label="${MY_MAGENTA}UNKNOWN ($status)${MY_DEFAULT}" ;;
      esac
      echo -e "Station $i: $label"
    fi
  done
}

# Check tftpboot netboot image version and build info.
# Usage: check-netboot [path/to/initrd.cpio.gz | directory]
#   No argument: ./initrd.cpio.gz, else the zebrabeach images in /tftpboot and ~/tftpboot.
check_tftpboot_image() {
  local target="${1:-}" img out
  local -a images=()
  # etc/os-release is a symlink to ../usr/lib/os-release in OVSS images, so read the target too.
  local -a files=(etc/version etc/build etc/os-release usr/lib/os-release etc/ovss-build-info/templateconf.cfg)

  if [[ -n "$target" ]]; then
    if [[ -f "$target" ]]; then
      images+=("$target")
    elif [[ -d "$target" ]]; then
      if [[ -f "${target%/}/initrd.cpio.gz" ]]; then
        images+=("${target%/}/initrd.cpio.gz")
      else
        while IFS= read -r img; do
          [[ -n "$img" ]] && images+=("$img")
        done < <(find "$target" -maxdepth 4 -name "initrd.cpio.gz" 2>/dev/null | sort)
      fi
    else
      my_echo "Error: Target '$target' not found." "$MY_RED"
      return 1
    fi
  elif [[ -f "./initrd.cpio.gz" ]]; then
    images+=("./initrd.cpio.gz")
  else
    local candidate
    for candidate in \
      /tftpboot/zebrabeach/initrd.cpio.gz \
      /tftpboot/zebrabeach-sf/initrd.cpio.gz \
      /tftpboot/zebrabeach-zf/initrd.cpio.gz \
      "${HOME}/tftpboot/zebrabeach/initrd.cpio.gz"; do
      [[ -f "$candidate" ]] && images+=("$candidate")
    done
    if [[ ${#images[@]} -eq 0 && -d /tftpboot ]]; then
      while IFS= read -r img; do
        [[ -n "$img" ]] && images+=("$img")
      done < <(find /tftpboot -maxdepth 4 -name "initrd.cpio.gz" 2>/dev/null | sort)
    fi
  fi

  if [[ ${#images[@]} -eq 0 ]]; then
    my_echo "No initrd.cpio.gz found in ./, /tftpboot or ~/tftpboot." "$MY_RED"
    my_echo "Usage: check-netboot [path/to/initrd.cpio.gz | directory]" "$MY_YELLOW"
    return 1
  fi

  for img in "${images[@]}"; do
    my_echo "=== Netboot Image: ${img} ===" "$MY_CYAN"
    _log_cmd "zcat ${img} | cpio -i --quiet --to-stdout ${files[*]} 2>/dev/null"
    out=$(zcat "$img" | cpio -i --quiet --to-stdout "${files[@]}" 2>/dev/null)
    if [[ -n "$out" ]]; then
      echo "$out"
    else
      my_echo "No version/build files found in ${img}." "$MY_RED"
    fi
    echo ""
  done
}

alias check-netboot="check_tftpboot_image"

